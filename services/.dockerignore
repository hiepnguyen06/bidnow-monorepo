# Build context is services/ (docker build -f services/<name>/Dockerfile services).
# The image runs the Maven reactor itself, so local build output stays out of the context.
**/target/
**/*.iml
**/.idea/
**/.vscode/
.git/
**/.gitignore
.mvn/
mvnw
mvnw.cmd
**/Dockerfile
docker-compose.yml
**/node_modules/
**/.next/
**/out/
**/build/
**/*.log
