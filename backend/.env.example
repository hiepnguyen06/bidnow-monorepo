# Copy to .env (gitignored) and fill in. Services read these as plain environment variables.

# --- Database (each service has its OWN database: override DB_URL per service when running it) ---
DB_URL=jdbc:postgresql://localhost:5432/<service_db>
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=change-me-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Messaging / cache (defaults shown; only set if different) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Mail (media-service) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM=no-reply@example.com
# FRONTEND_BASE_URL=http://localhost:3000

# --- Media storage (media-service): S3 uploads, images served via CloudFront ---
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=bidnow-media-dev
# CloudFront domain, no trailing slash. Same value as frontend NEXT_PUBLIC_CDN_URL.
CDN_BASE_URL=https://d1234abcd.cloudfront.net

# AWS credentials (local development only). On AWS the task/pod role is used; leave these unset there.
# Option A (recommended): a profile created with `aws configure --profile bidnow-dev`
AWS_PROFILE=bidnow-dev
# Option B: explicit keys of the dev IAM user (PutObject on the dev bucket only)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
